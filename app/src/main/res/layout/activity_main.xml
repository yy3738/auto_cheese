<?xml version="1.0" encoding="utf-8"?>
<!--
  弈枰主界面 v4 —— 墨纸编辑部(2026-10-13,用户从 A/B/C/D 4方案中选定 B):
  纸底 + 报头大字(弈枰+朱红竖规+英文小注) + 双细线
  + 黑细线直角棋盘(旧纸底) + 文字式工具行/细线 FEN
  + 目录式操作行(下划线) + 右下朱红大圆主按钮 + 纸底朱红墨条结果卡。
  所有控件 id 与 v3 一致,MainActivity 无需改动。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <!-- ═══ 报头 ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/titleView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="弈 枰"
            android:textSize="46sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:textColor="@color/ink"
            android:letterSpacing="0.1" />

        <View
            android:layout_width="3dp"
            android:layout_height="52dp"
            android:layout_marginStart="14dp"
            android:background="@color/accent_red" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHESS STUDIO"
                android:textSize="8sp"
                android:letterSpacing="0.38"
                android:textColor="@color/ink_soft" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="实战辅助 · 落子有据"
                android:textSize="10sp"
                android:letterSpacing="0.18"
                android:textColor="@color/ink" />
        </LinearLayout>
    </LinearLayout>

    <!-- 双细线:报头收束 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@color/ink" />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="3dp"
        android:background="@color/line_paper" />

    <!-- ═══ 棋盘:直角黑细线框,旧纸底 ═══ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="12dp"
        android:padding="8dp"
        android:background="@drawable/bg_board_paper">

        <com.cheese.assistant.ui.BoardView
            android:id="@+id/boardView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- ═══ 工具行:全文字式 ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="4dp">

        <Spinner
            android:id="@+id/piecePicker"
            android:layout_width="0dp"
            android:layout_weight="1.1"
            android:layout_height="34dp"
            android:background="@null" />

        <Button
            android:id="@+id/btnReset"
            style="@style/ChessBtn"
            android:background="@null"
            android:backgroundTint="@null"
            android:textColor="@color/ink_soft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textSize="12sp"
            android:text="@string/reset" />

        <Button
            android:id="@+id/btnClear"
            style="@style/ChessBtn"
            android:background="@null"
            android:backgroundTint="@null"
            android:textColor="@color/ink_soft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textSize="12sp"
            android:text="@string/clear" />

        <Button
            android:id="@+id/btnFlipSide"
            style="@style/ChessBtn"
            android:background="@null"
            android:backgroundTint="@null"
            android:textColor="@color/ink_soft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textSize="12sp"
            android:text="换先" />

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="2dp"
            android:background="@color/line_paper" />

        <Button
            android:id="@+id/btnCapture"
            style="@style/ChessBtn"
            android:background="@null"
            android:backgroundTint="@null"
            android:textColor="@color/ink_soft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textSize="12sp"
            android:text="@string/calibrate" />

        <Button
            android:id="@+id/btnRecognize"
            style="@style/ChessBtn"
            android:background="@null"
            android:backgroundTint="@null"
            android:textColor="@color/ink_soft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textSize="12sp"
            android:text="@string/recognize" />
    </LinearLayout>

    <!-- FEN:上细线 + 等宽小字 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="2dp"
        android:background="@color/line_paper" />
    <EditText
        android:id="@+id/fenView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="26dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="2dp"
        android:background="@null"
        android:textSize="9sp"
        android:fontFamily="monospace"
        android:textColor="@color/ink_soft"
        android:hint="FEN"
        android:inputType="none"
        android:focusable="false" />

    <!-- ═══ 底部:目录式次操作 + 朱红大圆主按钮 ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnReview"
                style="@style/ChessBtn"
                android:background="@drawable/bg_row_ink"
                android:backgroundTint="@null"
                android:textColor="@color/ink"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="start|center_vertical"
                android:paddingStart="2dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:text="对局复盘  →" />

            <Button
                android:id="@+id/btnAnalyze"
                style="@style/ChessBtn"
                android:background="@drawable/bg_row_ink"
                android:backgroundTint="@null"
                android:textColor="@color/ink"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="start|center_vertical"
                android:paddingStart="2dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:text="@string/analyze" />

            <Button
                android:id="@+id/btnLive"
                style="@style/ChessBtn"
                android:background="@drawable/bg_row_ink"
                android:backgroundTint="@null"
                android:textColor="@color/ink"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="start|center_vertical"
                android:paddingStart="2dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:text="对局实况  →" />
        </LinearLayout>

        <!-- 朱红大圆:主操作 -->
        <Button
            android:id="@+id/btnOverlay"
            style="@style/ChessBtn"
            android:background="@drawable/bg_circle_red"
            android:backgroundTint="@null"
            android:textColor="#FFFFFFFF"
            android:layout_width="94dp"
            android:layout_height="94dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:elevation="6dp"
            android:stateListAnimator="@null"
            android:text="开始\n实战辅助" />
    </LinearLayout>

    <!-- ═══ 结果卡:纸底 + 朱红墨条(分析当前局面/引擎输出显示区) ═══ -->
    <TextView
        android:id="@+id/resultView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"
        android:minHeight="52dp"
        android:padding="12dp"
        android:background="@drawable/bg_result_paper"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/res_text"
        android:textColorHint="#996B6455"
        android:hint="分析结果将显示在这里：点下方「分析当前局面」，引擎着法与评分逐行列出" />
</LinearLayout>
