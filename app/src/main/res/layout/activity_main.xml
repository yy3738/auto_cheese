<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_root"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="28dp"
    android:paddingBottom="16dp">

    <!-- ═══ 标题区:杂志式层级 + 印章 ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="棋 室"
                android:textSize="32sp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:textColor="@color/navy"
                android:letterSpacing="0.3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="实战辅助 · 落子有据"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.25" />
        </LinearLayout>

        <!-- 篆刻印章:藏蓝方章白字"弈" -->
        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_seal"
            android:gravity="center"
            android:text="弈"
            android:textSize="20sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF" />
    </LinearLayout>

    <!-- 细分隔线:标题区收束 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/divider_soft" />

    <!-- ═══ 摆盘工具条:统一胶囊 ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical">

        <Spinner
            android:id="@+id/piecePicker"
            android:layout_width="0dp"
            android:layout_weight="1.3"
            android:layout_height="36dp"
            android:background="@drawable/bg_pill" />

        <Button
            android:id="@+id/btnReset"
            style="@style/ChessBtn"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@null"
            android:textColor="@color/text_secondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:text="@string/reset" />

        <Button
            android:id="@+id/btnClear"
            style="@style/ChessBtn"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@null"
            android:textColor="@color/text_secondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:text="@string/clear" />

        <Button
            android:id="@+id/btnFlipSide"
            style="@style/ChessBtn"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@null"
            android:textColor="@color/text_secondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:text="换先" />
    </LinearLayout>

    <!-- ═══ 棋盘:白卡 + 藏蓝细框 + 投影 ═══ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:elevation="4dp"
        android:padding="8dp"
        android:background="@drawable/bg_board_frame">

        <com.cheese.assistant.ui.BoardView
            android:id="@+id/boardView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <EditText
        android:id="@+id/fenView"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="10dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/bg_fen"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textColor="@color/text_secondary"
        android:hint="FEN"
        android:inputType="none"
        android:focusable="false" />

    <!-- ═══ 主操作:藏蓝渐变胶囊 ═══ -->
    <Button
        android:id="@+id/btnOverlay"
        style="@style/ChessBtn"
        android:background="@drawable/bg_primary_btn"
        android:backgroundTint="@null"
        android:textColor="#FFFFFFFF"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:textSize="16sp"
        android:letterSpacing="0.15"
        android:elevation="6dp"
        android:stateListAnimator="@null"
        android:text="开始实战辅助" />

    <!-- ═══ 次操作:双幽灵卡(复盘=藏蓝描边,分析=灰描边) ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnReview"
            style="@style/ChessBtn"
            android:background="@drawable/bg_ghost_navy"
            android:backgroundTint="@null"
            android:textColor="@color/navy"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:textSize="14sp"
            android:text="对局复盘" />

        <Button
            android:id="@+id/btnAnalyze"
            style="@style/ChessBtn"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@null"
            android:textColor="@color/text_primary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:textSize="14sp"
            android:text="@string/analyze" />
    </LinearLayout>

    <!-- ═══ 诊断工具:降级为文字按钮 ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/btnCapture"
            style="@style/ChessBtn"
            android:background="@null"
            android:backgroundTint="@null"
            android:textColor="@color/text_secondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:textSize="12sp"
            android:text="@string/calibrate" />

        <Button
            android:id="@+id/btnRecognize"
            style="@style/ChessBtn"
            android:background="@null"
            android:backgroundTint="@null"
            android:textColor="@color/text_secondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:textSize="12sp"
            android:text="@string/recognize" />
    </LinearLayout>

    <!-- ═══ 结果卡:淡蓝染底 + 左墨条 ═══ -->
    <TextView
        android:id="@+id/resultView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="80dp"
        android:padding="12dp"
        android:background="@drawable/bg_result"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/text_primary" />
</LinearLayout>
