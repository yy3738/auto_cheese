<?xml version="1.0" encoding="utf-8"?>
<!--
  棋室主界面 v3 —— 书挡式版式(2026-10-12 大胆重构):
  藏蓝全出血英雄区(标题+印章+FEN) → 棋盘白卡上浮压住英雄区底缘(层级重叠)
  → 操作区(朱红主按钮+双次操作) → 墨色结果卡收底。
  与悬浮窗同一套语言:藏蓝渐变/白药丸/朱红点睛。
  外层负 margin 让棋盘卡顶进英雄区,形成"卡片浮在色块上"的层级感。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_deep">

    <!-- ═══ 英雄区:藏蓝渐变,全出血,仅底两角圆 ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_hero"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="52dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titleView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="棋 室"
                    android:textSize="36sp"
                    android:fontFamily="serif"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF"
                    android:letterSpacing="0.3" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="实战辅助 · 落子有据"
                    android:textSize="11sp"
                    android:textColor="#B3FFFFFF"
                    android:letterSpacing="0.25" />
            </LinearLayout>

            <!-- 朱红印章:点睛,呼应悬浮窗"下一局"强调色 -->
            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_seal_red"
                android:gravity="center"
                android:text="弈"
                android:textSize="24sp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:elevation="4dp" />
        </LinearLayout>

        <!-- FEN 条:嵌在英雄区内的半透明白药丸 -->
        <EditText
            android:id="@+id/fenView"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="20dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_fen_hero"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textColor="#FFFFFFFF"
            android:hint="FEN"
            android:textColorHint="#66FFFFFF"
            android:inputType="none"
            android:focusable="false" />

        <!-- 摆盘工具条:半透明白药丸,嵌在英雄区内 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <Spinner
                android:id="@+id/piecePicker"
                android:layout_width="0dp"
                android:layout_weight="1.3"
                android:layout_height="36dp"
                android:background="@drawable/bg_pill_hero" />

            <Button
                android:id="@+id/btnReset"
                style="@style/ChessBtn"
                android:background="@drawable/bg_pill_hero"
                android:backgroundTint="@null"
                android:textColor="#E6FFFFFF"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:textSize="12sp"
                android:text="@string/reset" />

            <Button
                android:id="@+id/btnClear"
                style="@style/ChessBtn"
                android:background="@drawable/bg_pill_hero"
                android:backgroundTint="@null"
                android:textColor="#E6FFFFFF"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:textSize="12sp"
                android:text="@string/clear" />

            <Button
                android:id="@+id/btnFlipSide"
                style="@style/ChessBtn"
                android:background="@drawable/bg_pill_hero"
                android:backgroundTint="@null"
                android:textColor="#E6FFFFFF"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:textSize="12sp"
                android:text="换先" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ 内容区 ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:clipChildren="false">

        <!-- 棋盘白卡:负 margin 顶进英雄区 → "浮在色块上"的层级 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="-36dp"
            android:elevation="8dp"
            android:padding="10dp"
            android:background="@drawable/bg_board_frame">

            <com.cheese.assistant.ui.BoardView
                android:id="@+id/boardView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- ═══ 主操作:朱红实底大按钮(点睛同色) ═══ -->
        <Button
            android:id="@+id/btnOverlay"
            style="@style/ChessBtn"
            android:background="@drawable/bg_primary_red"
            android:backgroundTint="@null"
            android:textColor="#FFFFFFFF"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:textSize="17sp"
            android:letterSpacing="0.15"
            android:elevation="6dp"
            android:stateListAnimator="@null"
            android:text="开始实战辅助" />

        <!-- ═══ 次操作:复盘(藏蓝实底白字) + 分析(白底藏蓝描边) ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnReview"
                style="@style/ChessBtn"
                android:background="@drawable/bg_solid_navy"
                android:backgroundTint="@null"
                android:textColor="#FFFFFFFF"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="46dp"
                android:textSize="14sp"
                android:text="对局复盘" />

            <Button
                android:id="@+id/btnAnalyze"
                style="@style/ChessBtn"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@null"
                android:textColor="@color/navy"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:textSize="14sp"
                android:text="@string/analyze" />
        </LinearLayout>

        <!-- ═══ 诊断工具:轻量文字行 ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <Button
                android:id="@+id/btnCapture"
                style="@style/ChessBtn"
                android:background="@null"
                android:backgroundTint="@null"
                android:textColor="@color/text_secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="34dp"
                android:textSize="12sp"
                android:text="@string/calibrate" />

            <Button
                android:id="@+id/btnRecognize"
                style="@style/ChessBtn"
                android:background="@null"
                android:backgroundTint="@null"
                android:textColor="@color/text_secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="34dp"
                android:textSize="12sp"
                android:text="@string/recognize" />
        </LinearLayout>

        <!-- ═══ 结果卡:藏蓝实底墨条收底,与英雄区呼应 ═══ -->
        <TextView
            android:id="@+id/resultView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="72dp"
            android:padding="14dp"
            android:background="@drawable/bg_result_navy"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3dp"
            android:textColor="#F2FFFFFF" />
    </LinearLayout>
</LinearLayout>
