<?xml version="1.0" encoding="utf-8"?>
<!-- 主按钮:朱红大圆。radial 渐变必须带 gradientRadius,否则inflate崩溃 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <gradient
        android:type="radial"
        android:centerX="0.35"
        android:centerY="0.3"
        android:gradientRadius="130dp"
        android:startColor="@color/vermillion"
        android:endColor="@color/vermillion_deep" />
</shape>
